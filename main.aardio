import key.hotkey;
import key;
import process;
import win.clip;
import win.clip.bitmap;
import win.ui.menu;
import win.util.tray;
import console;

var hotkey;
var isExiting = false;
var logError = function(stage,err){
	try{
		var now = time();
		if(!io.createDir("/log")) return;
		var file = io.file(io.fullpath("/log/" + now.format("%Y%m%d") + ".log"),"a");
		if(!file) return;
		file.write(now.format("%Y-%m-%d %H:%M:%S")," [",stage,"] ",err ? tostring(err) : "未知错误","\r\n");
		file.close();
	}
	catch(logErr){}
}

var tray = win.util.tray(mainForm);
tray.tip = "终端贴图";

mainForm.onTrayMessage = {
	[0x205/*_WM_RBUTTONUP*/] = function(wParam){
		var menu;
		try{
			win.setForeground(mainForm.hwnd,true);
			menu = win.ui.popmenu(mainForm);
			menu.add("显示窗口",function(){
				mainForm.show(true);
				win.setForeground(mainForm.hwnd);
			});
			menu.add();
			menu.add("退出",function(){
				isExiting = true;
				mainForm.close();
			});
			menu.popup();
		}
		catch(err){
			logError("托盘菜单",err);
		}
		if(menu){
			try{
				menu.close();
			}
			catch(err){
				logError("关闭托盘菜单",err);
			}
		}
	};
}

var debugLog = function(...){
	if(_STUDIO_INVOKED) console.log(...);
}

if(_STUDIO_INVOKED){
	console.open();
	debugLog("[终端贴图] 调试启动");
}

var addRecord = function(text){
	mainForm.record.text = text;
}

var isWindowsTerminal = function(hwnd){
	var pid = {INT value};
	if(!::User32.GetWindowThreadProcessId(hwnd,pid)){
		debugLog("[窗口] 无法读取焦点窗口进程，hwnd:",hwnd);
		return false;
	}
	var path = process.getPath(pid.value);
	debugLog("[窗口] 焦点窗口:",hwnd,"进程:",path : "<无法读取>");
	if(!path) return false;
	return string.endsWith(path,"WindowsTerminal.exe",true)
		|| string.endsWith(path,"wt.exe",true);
}

var saveClipboardImage = function(){
	var bitmap;
	try{
		debugLog("[转换] 开始读取剪贴板图片");
		bitmap = win.clip.bitmap.read();
		if(!bitmap){
			debugLog("[转换] 读取剪贴板图片失败");
			logError("读取剪贴板图片","剪贴板图片已不可用");
			return addRecord(time().format("%m-%d %H:%M:%S") + "丨读取失败");
		}

		var now = time();
		var dir = "/img/" + now.format("%Y%m%d");
		if(!io.createDir(dir)){
			bitmap.dispose();
			bitmap = null;
			debugLog("[转换] 创建目录失败:",io.fullpath(dir));
			logError("创建图片目录",io.fullpath(dir));
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨保存失败");
		}

		var stem = now.format("%Y%m%d%H%M%S");
		var filename = stem + ".jpg";
		var path = io.fullpath(dir + "/" + filename);
		var index = 1;
		while(io.exist(path)){
			filename = stem + "_" + index + ".jpg";
			path = io.fullpath(dir + "/" + filename);
			index++;
		}

		var ok,err = bitmap.save(path,90);
		bitmap.dispose();
		bitmap = null;
		if(!ok){
			debugLog("[转换] JPG 保存失败:",path,err);
			logError("保存 JPG",err);
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨保存失败");
		}
		debugLog("[转换] JPG 保存成功:",path);

		if(!win.clip.write(path)){
			debugLog("[转换] 写入路径到剪贴板失败");
			logError("写入剪贴板",path);
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨剪贴板失败");
		}
		addRecord(now.format("%m-%d %H:%M:%S") + "丨" + filename);
		debugLog("[转换] 已写入剪贴板，等待原 Ctrl+V 释放");
		key.waitUp("V");
		key.waitUp("CTRL");
		win.delay(30);
		debugLog("[转换] 原按键已释放，准备发送 Ctrl+V");
		key.combine("CTRL","V");
		debugLog("[转换] Ctrl+V 已发送");
	}
	catch(err){
		if(bitmap){
			try{
				bitmap.dispose();
			}
			catch(disposeErr){
				logError("释放图片资源",disposeErr);
			}
		}
		debugLog("[转换] 处理异常:",err);
		logError("图片转换",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨处理失败");
	}
}

var startListening = function(){
	var newHotkey;
	try{
		debugLog("[监听] 正在创建热键对象");
		newHotkey = key.hotkey();
		debugLog("[监听] 热键对象已创建，正在注册 Ctrl+V");
		newHotkey.regStr("CTRL+V",function(hwnd){
			var send = true;
			try{
				debugLog("[热键] 捕获 Ctrl+V");
				var terminalOk = isWindowsTerminal(hwnd);
				var imageOk = win.clip.bitmap.test();
				debugLog("[判断] Windows Terminal:",terminalOk,"剪贴板图片:",imageOk);
				if(!terminalOk || !imageOk){
					debugLog("[热键] 条件不满足，放行原 Ctrl+V");
				}
				else{
					debugLog("[热键] 条件满足，拦截并开始转换");
					send = saveClipboardImage;
				}
			}
			catch(err){
				debugLog("[热键] 判断异常:",err);
				logError("判断粘贴条件",err);
			}
			return send;
		});
		hotkey = newHotkey;
		debugLog("[监听] Ctrl+V 注册完成");
		mainForm.listenButton.text = "停止监听";
		debugLog("[监听] 已开始");
	}
	catch(err){
		if(newHotkey){
			try{
				newHotkey.close();
			}
			catch(closeErr){
				logError("清理监听",closeErr);
			}
		}
		hotkey = null;
		mainForm.listenButton.text = "开始监听";
		debugLog("[监听] 启动失败:",err);
		logError("启动监听",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨监听失败");
	}
}

var stopListening = function(){
	if(hotkey){
		var currentHotkey = hotkey;
		var closeError;
		try{
			currentHotkey.close();
			hotkey = null;
		}
		catch(err){
			closeError = err;
			debugLog("[监听] 停止失败:",err);
			logError("停止监听",err);
		}
		if(closeError) return addRecord(time().format("%m-%d %H:%M:%S") + "丨停止失败");
	}
	mainForm.listenButton.text = "开始监听";
	debugLog("[监听] 已停止");
}

mainForm.listenButton.oncommand = function(){
	debugLog("[界面] 监听按钮已点击");
	if(hotkey) stopListening();
	else startListening();
}

mainForm.onClose = function(){
	if(isExiting) return true;
	mainForm.show(false);
	return false;
}

mainForm.onDestroy = function(){
	stopListening();
	try{
		tray.delete();
	}
	catch(err){
		logError("删除托盘图标",err);
	}
}

mainForm.show();
return win.loopMessage();
