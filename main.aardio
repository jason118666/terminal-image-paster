import win.region.round;
import win.ui.simpleWindow2;
win.region.round(mainForm);
var windowChrome = win.ui.simpleWindow2(mainForm);
windowChrome.skin({
	background={
		default=0x00000000;
		hover=0xFFDCEBFA;
		active=0xFFCDDFF3
	};
	color={
		default=0xFF445F75;
		hover=0xFF245A83;
		active=0xFF123F62
	}
})
windowChrome.titlebarClose.skin({
	background={
		default=0x00000000;
		hover=0xFFFBE7E6;
		active=0xFFF5D2D0
	};
	color={
		default=0xFF445F75;
		hover=0xFFA33A35;
		active=0xFF7D2925
	}
})

var toggleSkin = function(background,color,border){
	return {
		background={default=background[1];hover=background[2];active=background[3]};
		color={default=color[1];hover=color[2];active=color[3]};
		border={
			default={color=border[1];radius=5;width=1};
			hover={color=border[2];radius=5;width=1};
			active={color=border[3];radius=5;width=1}
		}
	}
}

var enabledBackground = {0xFFE8F1FB,0xFFDCEBFA,0xFFCDDFF3};
var enabledColor = {0xFF245A83,0xFF174E78,0xFF123F62};
var enabledBorder = {0xFFCDDEEF,0xFFAAC9E8,0xFF8DB5DD};
var disabledBackground = {0xFFEEF1F4,0xFFE4E8ED,0xFFD8DEE5};
var disabledColor = {0xFF64748B,0xFF475569,0xFF334155};
var disabledBorder = {0xFFD5DCE4,0xFFC3CCD6,0xFFB0BBC8};

var setToggleState = function(toggle,enabled){
	toggle.text = enabled ? "已启用" : "已禁用";
	toggle.skin(enabled ? toggleSkin(enabledBackground,enabledColor,enabledBorder) : toggleSkin(disabledBackground,disabledColor,disabledBorder));
}
setToggleState(mainForm.terminalToggle,false);
setToggleState(mainForm.feishuToggle,false);

import key.hotkey;
import key;
import mouse.hook;
import JSON;
import System.Windows.Automation.3;
import process;
import win.clip;
import win.clip.bitmap;
import win.ui.menu;
import win.util.tray;
import console;

var hotkey;
var isExiting = false;
var logError = function(stage,err){
	try{
		var now = time();
		if(!io.createDir("/log")) return;
		var file = io.file(io.fullpath("/log/" + now.format("%Y%m%d") + ".log"),"a");
		if(!file) return;
		file.write(now.format("%Y-%m-%d %H:%M:%S")," [",stage,"] ",err ? tostring(err) : "未知错误","\r\n");
		file.close();
	}
	catch(logErr){}
}

var tray = win.util.tray(mainForm);
tray.tip = "终端贴图";

mainForm.onTrayMessage = {
	[0x205/*_WM_RBUTTONUP*/] = function(wParam){
		var menu;
		try{
			win.setForeground(mainForm.hwnd,true);
			menu = win.ui.popmenu(mainForm);
			menu.add("显示窗口",function(){
				mainForm.show(true);
				win.setForeground(mainForm.hwnd);
			});
			menu.add();
			menu.add("退出",function(){
				isExiting = true;
				mainForm.close();
			});
			menu.popup();
		}
		catch(err){
			logError("托盘菜单",err);
		}
		if(menu){
			try{
				menu.close();
			}
			catch(err){
				logError("关闭托盘菜单",err);
			}
		}
	};
}

var debugLog = function(...){
	if(_STUDIO_INVOKED) console.log(...);
}

if(_STUDIO_INVOKED){
	console.open();
	debugLog("[终端贴图] 调试启动");
}

var addRecord = function(text){
	mainForm.record.text = text;
}

var getWindowProcessPath = function(hwnd){
	var pid = {INT value};
	if(!::User32.GetWindowThreadProcessId(hwnd,pid)){
		debugLog("[窗口] 无法读取焦点窗口进程，hwnd:",hwnd);
		return null;
	}
	return process.getPath(pid.value);
}

var isWindowsTerminal = function(hwnd){
	var path = getWindowProcessPath(hwnd);
	//debugLog("[窗口] 焦点窗口:",hwnd,"进程:",path : "<无法读取>");
	if(!path) return false;
	return string.endsWith(path,"WindowsTerminal.exe",true)
		|| string.endsWith(path,"wt.exe",true);
}

var isFeishu = function(hwnd){
	var path = getWindowProcessPath(hwnd);
	//debugLog("[窗口] 前台窗口:",hwnd,"进程:",path : "<无法读取>");
	if(!path) return false;
	return string.endsWith(path,"Feishu.exe",true)
		|| string.endsWith(path,"Lark.exe",true);
}

var saveClipboardImage = function(){
	var bitmap;
	try{
		//debugLog("[转换] 开始读取剪贴板图片");
		bitmap = win.clip.bitmap.read();
		if(!bitmap){
			debugLog("[转换] 读取剪贴板图片失败");
			logError("读取剪贴板图片","剪贴板图片已不可用");
			return addRecord(time().format("%m-%d %H:%M:%S") + "丨读取失败");
		}

		var now = time();
		var dir = "/img/" + now.format("%Y%m%d");
		if(!io.createDir(dir)){
			bitmap.dispose();
			bitmap = null;
			debugLog("[转换] 创建目录失败:",io.fullpath(dir));
			logError("创建图片目录",io.fullpath(dir));
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨保存失败");
		}

		var stem = now.format("%Y%m%d%H%M%S");
		var filename = stem + ".jpg";
		var path = io.fullpath(dir + "/" + filename);
		var index = 1;
		while(io.exist(path)){
			filename = stem + "_" + index + ".jpg";
			path = io.fullpath(dir + "/" + filename);
			index++;
		}

		var ok,err = bitmap.save(path,90);
		bitmap.dispose();
		bitmap = null;
		if(!ok){
			debugLog("[转换] JPG 保存失败:",path,err);
			logError("保存 JPG",err);
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨保存失败");
		}
		debugLog("[转换] JPG 保存成功:",path);

		if(!win.clip.write(path)){
			debugLog("[转换] 写入路径到剪贴板失败");
			logError("写入剪贴板",path);
			return addRecord(now.format("%m-%d %H:%M:%S") + "丨剪贴板失败");
		}
		addRecord(now.format("%m-%d %H:%M:%S") + "丨" + filename);
		//debugLog("[转换] 已写入剪贴板，等待原 Ctrl+V 释放");
		key.waitUp("V");
		key.waitUp("CTRL");
		win.delay(30);
		//debugLog("[转换] 原按键已释放，准备发送 Ctrl+V");
		key.combine("CTRL","V");
		//debugLog("[转换] Ctrl+V 已发送");
	}
	catch(err){
		if(bitmap){
			try{
				bitmap.dispose();
			}
			catch(disposeErr){
				logError("释放图片资源",disposeErr);
			}
		}
		debugLog("[转换] 处理异常:",err);
		logError("图片转换",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨处理失败");
	}
}

var startListening = function(){
	var newHotkey;
	try{
		//debugLog("[监听] 正在创建热键对象");
		newHotkey = key.hotkey();
		//debugLog("[监听] 热键对象已创建，正在注册 Ctrl+V");
		newHotkey.regStr("CTRL+V",function(hwnd){
			var send = true;
			try{
				//debugLog("[热键] 捕获 Ctrl+V");
				var terminalOk = isWindowsTerminal(hwnd);
				var imageOk = win.clip.bitmap.test();
				//debugLog("[判断] Windows Terminal:",terminalOk,"剪贴板图片:",imageOk);
				if(!terminalOk || !imageOk){
					//debugLog("[热键] 条件不满足，放行原 Ctrl+V");
				}
				else{
					debugLog("[热键] 条件满足，拦截并开始转换");
					send = saveClipboardImage;
				}
			}
			catch(err){
				debugLog("[热键] 判断异常:",err);
				logError("判断粘贴条件",err);
			}
			return send;
		});
		hotkey = newHotkey;
		//debugLog("[监听] Ctrl+V 注册完成");
		setToggleState(mainForm.terminalToggle,true);
		debugLog("[监听] 已开始");
	}
	catch(err){
		if(newHotkey){
			try{
				newHotkey.close();
			}
			catch(closeErr){
				logError("清理监听",closeErr);
			}
		}
		hotkey = null;
		setToggleState(mainForm.terminalToggle,false);
		debugLog("[监听] 启动失败:",err);
		logError("启动监听",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨监听失败");
	}
}

var stopListening = function(){
	if(hotkey){
		var currentHotkey = hotkey;
		var closeError;
		try{
			currentHotkey.close();
			hotkey = null;
		}
		catch(err){
			closeError = err;
			debugLog("[监听] 停止失败:",err);
			logError("停止监听",err);
		}
		if(closeError) return addRecord(time().format("%m-%d %H:%M:%S") + "丨停止失败");
	}
	setToggleState(mainForm.terminalToggle,false);
	debugLog("[监听] 已停止");
}

mainForm.terminalToggle.oncommand = function(){
	//debugLog("[界面] 终端贴图开关已点击");
	if(hotkey) stopListening();
	else startListening();
}

//飞书三击 @ 助手：鼠标钩子统计左键连击，三击后检测焦点是否在输入框，是则输入 @ 文本并回车

//飞书输入框在 UIA 中是类名含此字符串的 Group
var FEISHU_EDITOR_CLASS = "editor-kit-container";
//三击后等多久再检测焦点（毫秒），要等飞书先处理完这次点击
var FEISHU_CLICK_DELAY = 80;
//首次检测失败后的补测间隔（毫秒），飞书的无障碍树首次被访问时可能还没就绪
var FEISHU_RETRY_DELAY = 300;

//配置文件 config.json 位于程序目录，缺失时按默认值生成，修改后下次三击即生效
var CONFIG_PATH = "/config.json";
var DEFAULT_CONFIG = {
	feishu = {
		mentionName = "嘉胜的智能助手";
		autoConfirm = true;
		confirmDelay = 200
	}
}

//返回要输入的文本、是否自动回车、回车延时，读不出来的项用默认值
var loadFeishuConfig = function(){
	var path = io.fullpath(CONFIG_PATH);
	var feishu;
	try{
		if(!io.exist(path)){
			string.save(path,JSON.stringify(DEFAULT_CONFIG,true));
		}
		var cfg,err = JSON.load(path);
		if(!cfg){
			logError("解析配置文件",err);
		}
		else feishu = cfg[["feishu"]];
	}
	catch(err){
		logError("读取配置文件",err);
	}

	var name = feishu && feishu[["mentionName"]];
	var confirm = feishu && feishu[["autoConfirm"]];
	var delay = feishu && feishu[["confirmDelay"]];
	name = type(name) == "string" ? string.trim(name) : "";
	if(name[1] == '@'#) name = string.slice(name,2);
	if(!#name) name = DEFAULT_CONFIG.feishu.mentionName;
	if(type(delay) != "number" || delay < 0) delay = DEFAULT_CONFIG.feishu.confirmDelay;
	return "@" + name,confirm === true,delay;
}

var Automation = System.Windows.Automation;
var AutomationElement = Automation.AutomationElement;
var unhookWindowsHookEx = ::User32.api("UnhookWindowsHookEx","int(pointer hhk)");

var mouseHook;
//输入与回车尚未走完时为 true，期间的三击一律忽略，避免重叠触发导致多按回车
var mentioning = false;
var clickCount = 0;
var lastClickTime,lastClickX,lastClickY;

//焦点可能落在输入框内部的子节点上，所以从焦点元素向上最多找 5 层
var isFeishuEditorFocused = function(){
	var ele = AutomationElement.RootElement.FocusedElement;
	for(i=1;5;1){
		if(!ele) return false;
		var className = ele.Current.ClassName;
		//debugLog("[飞书][UIA] 第" + i + "层 类名:",className,"名称:",ele.Current.Name,"进程:",ele.Current.ProcessId);
		if(className && string.indexOf(className,FEISHU_EDITOR_CLASS)) return true;
		ele = Automation.TreeWalker.RawViewWalker.GetParent(ele);
	}
	return false;
}

var checkFeishuEditorFocused = function(){
	var focused;
	try{
		focused = isFeishuEditorFocused();
	}
	catch(err){
		debugLog("[飞书] 检测输入框异常:",err);
		logError("检测飞书输入框",err);
	}
	return focused;
}

var mentionAssistant = function(attempt=1){
	if(!mouseHook || mentioning || !isFeishu(::User32.GetForegroundWindow())) return;

	if(!checkFeishuEditorFocused()){
		if(attempt < 2){
			mainForm.setTimeout(function(){
				mentionAssistant(attempt + 1);
			},FEISHU_RETRY_DELAY);
		}
		else debugLog("[飞书] 焦点不在输入框，已忽略本次三击");
		return;
	}

	try{
		var mentionText,autoConfirm,confirmDelay = loadFeishuConfig();
		mentioning = true;
		key.sendString(mentionText);
		debugLog("[飞书] 已输入:",mentionText);
		if(autoConfirm){
			//等候选人列表弹出后再回车选中
			mainForm.setTimeout(function(){
				key.press("ENTER");
				mentioning = false;
				debugLog("[飞书] 已回车");
			},confirmDelay);
		}
		else mentioning = false;
		addRecord(time().format("%m-%d %H:%M:%S") + "丨" + mentionText);
	}
	catch(err){
		mentioning = false;
		debugLog("[飞书] 输入异常:",err);
		logError("飞书@助手",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨@助手失败");
	}
}

//钩子回调必须快速返回，只统计左键连击，检测和输入放到 setTimeout 里做
var onMouseMessage = function(msg,x,y,mouseData,injected,flags,timeStamp){
	if(injected || msg != 0x201/*_WM_LBUTTONDOWN*/) return;

	//与上一次点击的间隔和位置都在系统双击容差内才算连击
	var cx = ::User32.GetSystemMetrics(36/*_SM_CXDOUBLECLK*/) / 2;
	var cy = ::User32.GetSystemMetrics(37/*_SM_CYDOUBLECLK*/) / 2;
	if(lastClickTime
		&& timeStamp - lastClickTime <= ::User32.GetDoubleClickTime()
		&& math.abs(x - lastClickX) <= cx
		&& math.abs(y - lastClickY) <= cy){
		clickCount++;
	}
	else{
		clickCount = 1;
	}
	lastClickTime,lastClickX,lastClickY = timeStamp,x,y;
	//debugLog("[飞书][钩子] 左键按下 坐标:",x,y,"连击数:",clickCount);

	if(clickCount >= 3){
		clickCount = 0;
		lastClickTime = null;
		//debugLog("[飞书][钩子] 检测到三击");
		if(isFeishu(::User32.GetForegroundWindow())){
			mainForm.setTimeout(mentionAssistant,FEISHU_CLICK_DELAY);
		}
	}
}

var startFeishuMention = function(){
	var newHook;
	try{
		newHook = mouse.hook();
		if(!newHook._hhk) error("鼠标钩子创建失败");
		newHook.proc = onMouseMessage;
		clickCount = 0;
		lastClickTime = null;
		mouseHook = newHook;
		setToggleState(mainForm.feishuToggle,true);
		debugLog("[飞书] 已开始");
	}
	catch(err){
		if(newHook && newHook._hhk) unhookWindowsHookEx(newHook._hhk);
		mouseHook = null;
		setToggleState(mainForm.feishuToggle,false);
		debugLog("[飞书] 启动失败:",err);
		logError("启动飞书@助手",err);
		addRecord(time().format("%m-%d %H:%M:%S") + "丨飞书启用失败");
	}
}

var stopFeishuMention = function(){
	if(mouseHook){
		var currentHook = mouseHook;
		mouseHook = null;
		try{
			//mouse.hook 自带的 close 取不到钩子句柄，这里直接卸载
			unhookWindowsHookEx(currentHook._hhk);
			currentHook._hhk = null;
		}
		catch(err){
			debugLog("[飞书] 停止失败:",err);
			logError("停止飞书@助手",err);
		}
	}
	setToggleState(mainForm.feishuToggle,false);
	debugLog("[飞书] 已停止");
}

mainForm.feishuToggle.oncommand = function(){
	if(mouseHook) stopFeishuMention();
	else startFeishuMention();
}

mainForm.onClose = function(){
	if(isExiting) return true;
	mainForm.show(false);
	return false;
}

mainForm.onDestroy = function(){
	stopListening();
	stopFeishuMention();
	try{
		tray.delete();
	}
	catch(err){
		logError("删除托盘图标",err);
	}
}

mainForm.show();
return win.loopMessage();
