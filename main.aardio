titleDivider={cls="bk";left=0;top=29;right=250;bottom=30;bgcolor=0xF0E5D9;dl=1;dr=1;dt=1;z=3};
listenButton={cls="plus";text="开始监听";left=75;top=40;right=175;bottom=68;bgcolor=0xFBF1E8;border={color=0xFFCDDEEF;radius=7;width=1};color=0x835A24;font=LOGFONT(h=-13);notify=1;z=4};
